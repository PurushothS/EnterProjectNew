{
  "name": "playwright-test-automation-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Production-ready Playwright UI and API automation starter kit",
  "keywords": [
    "playwright",
    "typescript",
    "test-automation",
    "e2e-testing",
    "api-testing",
    "ui-testing",
    "quality-assurance"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmetkemalsari/playwright-test-automation-template.git"
  },
  "homepage": "https://github.com/ahmetkemalsari/playwright-test-automation-template#readme",
  "bugs": {
    "url": "https://github.com/ahmetkemalsari/playwright-test-automation-template/issues"
  },
  "scripts": {
    "test": "node scripts/run-tests.mjs --project=chromium-public --project=chromium --project=api",
    "test:dev": "cross-env TEST_ENV=dev node scripts/run-tests.mjs --project=chromium-public --project=chromium --project=api",
    "test:staging": "cross-env TEST_ENV=staging node scripts/run-tests.mjs --project=chromium-public --project=chromium --project=api",
    "test:prod": "cross-env TEST_ENV=prod node scripts/run-tests.mjs --project=chromium-public --project=chromium --project=api",
    "test:smoke": "node scripts/run-tests.mjs --grep @smoke --project=chromium-public --project=api",
    "test:regression": "node scripts/run-tests.mjs --grep @regression",
    "test:api": "node scripts/run-tests.mjs --grep @api --project=api",
    "test:e2e": "node scripts/run-tests.mjs --grep @e2e --project=chromium",
    "test:chromium": "node scripts/run-tests.mjs --project=chromium-public --project=chromium",
    "test:firefox": "node scripts/run-tests.mjs --project=firefox",
    "test:webkit": "node scripts/run-tests.mjs --project=webkit",
    "test:headed": "node scripts/run-tests.mjs --project=chromium --headed",
    "test:debug": "node scripts/run-tests.mjs --project=chromium --debug",
    "test:ui": "node scripts/run-tests.mjs --ui",
    "report": "playwright show-report",
    "allure:open": "allure open allure-report",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "^26.6.6",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.15.0",
    "cross-env": "^10.0.0",
    "dotenv": "^18.0.10",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.2",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.38.0"
  }
}
